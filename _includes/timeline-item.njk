<div class="timeline-item">
  <div class="tl-year">
    {{ item.period }}{% if item.tag %} ·
      <span class="lang-en">{{ item.tag }}</span>
    {% endif %}
  </div>
  <div class="tl-title">
    <span class="lang-en">{{ item.title }}</span>
  </div>
  <div class="tl-org">
    {% if item.org %}
      <span class="lang-en">{{ item.org }}</span>
    {% else %}
      {{ item.org }}{% if item.location %} · {{ item.location }}{% endif %}
    {% endif %}
  </div>
  {% if item.description %}
    <div class="tl-desc">
      {{ item.description }}
      {% if item.bullets and item.bullets.length %}
        <ul>
          {% for bullet in item.bullets %}
            <li>{{ bullet }}</li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>
  {% endif %}
  {% if item.chips and item.chips.length %}
    <div class="tl-chips">
      {% for chip in item.chips %}
        <span class="chip">{{ chip }}</span>
      {% endfor %}
    </div>
  {% endif %}
</div>
