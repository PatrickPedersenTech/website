          linkedin.com/in/patrick-j-s-pedersen
        </a>
        <a class="contact-item" href="https://github.com/PatrickPedersen" target="_blank" rel="noopener">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2A10 10 0 0 0 2 12C2 16.42 4.87 20.17 8.84 21.5C9.34 21.58 9.5 21.27 9.5 21C9.5 20.77 9.5 20.14 9.5 19.31C6.73 19.91 6.14 17.97 6.14 17.97C5.68 16.81 5.03 16.5 5.03 16.5C4.12 15.88 5.1 15.9 5.1 15.9C6.1 15.97 6.63 16.93 6.63 16.93C7.5 18.45 8.97 18 9.54 17.76C9.63 17.11 9.89 16.67 10.17 16.42C7.95 16.17 5.62 15.31 5.62 11.5C5.62 10.39 6 9.5 6.65 8.79C6.55 8.54 6.2 7.5 6.75 6.15C6.75 6.15 7.59 5.88 9.5 7.17C10.29 6.95 11.15 6.84 12 6.84C12.85 6.84 13.71 6.95 14.5 7.17C16.41 5.88 17.25 6.15 17.25 6.15C17.8 7.5 17.45 8.54 17.35 8.79C18 9.5 18.38 10.39 18.38 11.5C18.38 15.32 16.04 16.16 13.81 16.41C14.17 16.72 14.5 17.33 14.5 18.26C14.5 19.6 14.5 20.68 14.5 21C14.5 21.27 14.66 21.59 15.17 21.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2Z"/></svg>
          github.com/PatrickPedersen
        </a>
        <a class="contact-item" href="https://patrickpedersen.tech" target="_blank" rel="noopener">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
          patrickpedersen.tech
        </a>
        <span class="contact-item">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          Denmark
        </span>
      </div>

      <div class="sidebar-section">
        <div class="sidebar-label">Core skills</div>
        <div class="sidebar-chips">
          {% for s in ["Linux","Azure","Docker","Terraform","CI/CD","PowerShell","Bash","Cloudflare","GitHub Actions"] %}
            <span class="sidebar-chip">{{ s }}</span>
          {% endfor %}
        </div>
      </div>

      <div class="sidebar-section">
        <div class="sidebar-label">Languages</div>
        <div class="lang-row"><span>Danish</span><span class="lang-level">Native</span></div>
        <div class="lang-row"><span>English</span><span class="lang-level">Fluent</span></div>
      </div>
    </aside>

    <!-- MAIN -->
    <main class="cv-main">

      <div class="cv-section">
        <div class="cv-section-title">Profile</div>
        <div class="cv-entry" style="border-bottom:none; padding-bottom:0; margin-bottom:0;">
          <p class="entry-desc">
            Freshly graduated Datatechnician with a specialization in Infrastructure, looking for a role in SysAdmin, DevOps, or platform engineering. I'm hands-on across Linux environments, comfortable in the cloud and on-prem, and focused on building systems that are reliable, automated, and maintainable.
          </p>
        </div>
      </div>

      <div class="cv-section">
        <div class="cv-section-title">Education</div>
        {% for item in education %}
          <div class="cv-entry">
            <div class="entry-header">
              <div class="entry-title">
                <span class="lang-en">{{ item.title.en }}</span>
                <span class="lang-da">{{ item.title.da }}</span>
              </div>
              <div class="entry-date">{{ item.period }}</div>
            </div>
            <div class="entry-org">
              {% if item.org.en %}
                <span class="lang-en">{{ item.org.en }}</span>
                <span class="lang-da">{{ item.org.da }}</span>
              {% else %}
                {{ item.org }}
              {% endif %}
            </div>
            <div class="entry-desc">
              {{ item.description }}
              {% if item.bullets and item.bullets.length %}
                <ul>
                  {% for bullet in item.bullets %}
                    <li>{{ bullet }}</li>
                  {% endfor %}
                </ul>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>

      <div class="cv-section">
        <div class="cv-section-title">Experience</div>
        {% for item in experience %}
          <div class="cv-entry">
            <div class="entry-header">
              <div class="entry-title">
                <span class="lang-en">{{ item.title.en }}</span>
                <span class="lang-da">{{ item.title.da }}</span>
              </div>
              <div class="entry-date">
                {{ item.period }}
                {% if item.tag %}·
                  <span class="lang-en">{{ item.tag.en }}</span>
                  <span class="lang-da">{{ item.tag.da }}</span>
                {% endif %}
              </div>
            </div>
            <div class="entry-org">
              {% if item.org.en %}
                <span class="lang-en">{{ item.org.en }}</span>
                <span class="lang-da">{{ item.org.da }}</span>
              {% else %}
                {{ item.org }}{% if item.location %} · {{ item.location }}{% endif %}
              {% endif %}
            </div>
            <div class="entry-desc">
              {{ item.description }}
              {% if item.cv_bullets and item.cv_bullets.length %}
                <ul>
                  {% for bullet in item.cv_bullets %}
                    <li>{{ bullet }}</li>
                  {% endfor %}
                </ul>
              {% endif %}
            </div>
            {% if item.chips and item.chips.length %}
              <div class="entry-chips">
                {% for chip in item.chips %}
                  <span class="chip">{{ chip }}</span>
                {% endfor %}
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>

      <div class="cv-section">
        <div class="cv-section-title">Selected projects</div>
        {% set devProjects   = projects | selectattr("category", "equalto", "development")     | list %}
        {% set infraProjects = projects | selectattr("category", "equalto", "infrastructure")  | list %}
        {% for group in [
          { "label": "Development",            "items": devProjects },
          { "label": "Infrastructure & DevOps","items": infraProjects }
        ] %}
          <div class="cv-project-group">
            <div class="cv-project-group-label">{{ group.label }}</div>
            {% for project in group.items %}
              <div class="cv-entry">
                <div class="entry-header">
                  <div class="entry-title">
                    {{ project.title }}
                    {% if project.collab %}<span style="font-size:10px; font-family:var(--mono); color:var(--muted); font-weight:400; margin-left:6px;">collaborative</span>{% endif %}
                  </div>
                  {% if project.link %}
                    <a href="{{ project.link }}" target="_blank" rel="noopener" style="font-family:var(--mono); font-size:11px; color:var(--accent); text-decoration:none; white-space:nowrap; flex-shrink:0;">GitHub ↗</a>
                  {% endif %}
                </div>
                <div class="entry-desc">
                  {{ project.cv_description or project.description }}
                  {% if project.cv_bullets and project.cv_bullets.length %}
                    <ul>
                      {% for bullet in project.cv_bullets %}
                        <li>{{ bullet }}</li>
                      {% endfor %}
                    </ul>
                  {% endif %}
                </div>
                <div class="entry-chips">
                  {% for chip in project.chips %}
                    <span class="chip">{{ chip }}</span>
                  {% endfor %}
                </div>
              </div>
            {% endfor %}
          </div>
        {% endfor %}
      </div>

      {# <div class="cv-section">
        <div class="cv-section-title">Certifications</div>
        <div class="cv-entry" style="border-bottom:none; padding-bottom:0; margin-bottom:0;">
          <p class="entry-desc" style="color:var(--muted); font-style:italic;">Add certifications here — e.g. AZ-900 Azure Fundamentals, CompTIA Network+</p>
        </div>
      </div> #}

    </main>
  </div>
</div>
