<!-- ABOUT -->
<section id="about">
  <p class="section-label">// 01 · about</p>
  <h2 class="section-title">Who I am</h2>
  <div class="about-grid">
    <div class="about-card">
      <h3>Background</h3>
      <p>I'm a freshly graduated Datatechnician with a specialization in Infrastructure, based in Denmark. My work spans both SysAdmin and DevOps — from managing servers and networks to building automated pipelines and containerized workloads.</p>
    </div>
    <div class="about-card">
      <h3>What I do</h3>
      <p>I keep systems running, secure, and scalable. Whether that's setting up CI/CD with GitHub Actions, or writing PowerShell and Bash to automate the repetitive stuff.</p>
    </div>
    <div class="about-card">
      <h3>Platforms I know</h3>
      <p>Comfortable across Linux (Rocky, Fedora, Arch, Debian) environments. I work with on-prem and Azure cloud infrastructure, with hands-on experience in Docker and Azure Devops Pipelines for GitOps workflows.</p>
    </div>
    <div class="about-card">
      <h3>Currently</h3>
      <p>Freshly graduated and looking for my next challenge. I'm interested in roles in infrastructure, platform engineering, or DevOps — preferably somewhere I can keep learning and contribute to reliable systems at scale.</p>
    </div>
  </div>
</section>

<div class="divider"></div>

<!-- SKILLS -->
<section id="skills">
  <p class="section-label">// 02 · skills</p>
  <h2 class="section-title">Tech stack</h2>

  {% set categories = [
    { "id": "languages", "label": "Languages & scripting" },
    { "id": "platforms", "label": "Platforms & OS" },
    { "id": "tools",     "label": "CI/CD & tools" },
    { "id": "monitoring","label": "Monitoring & observability" },
    { "id": "webservers","label": "Web servers" },
    { "id": "databases", "label": "Databases" }
  ] %}

  {% for cat in categories %}
    <div class="skill-group {% if loop.last %}skill-group--last{% endif %}">
      <div class="skill-group-label">{{ cat.label }}</div>
      <div class="skills-grid">
        {% for skill in skills %}
          {% if skill.category == cat.id %}
            {% include "skill-card.njk" %}
          {% endif %}
        {% endfor %}
      </div>
    </div>
  {% endfor %}

  <div class="skills-see-all">
    <a class="btn btn-ghost btn-sm" href="/allskills/">View full skill list →</a>
  </div>
</section>

<div class="divider"></div>

<!-- EDUCATION -->
<section id="education">
  <p class="section-label">// 03 · education</p>
  <h2 class="section-title">Education</h2>
  <div class="timeline">
    {% for item in education %}
      {% include "timeline-item.njk" %}
    {% endfor %}
  </div>
</section>

<div class="divider"></div>

<!-- EXPERIENCE -->
<section id="experience">
  <p class="section-label">// 04 · experience</p>
  <h2 class="section-title">Work experience</h2>
  <div class="timeline">
    {% for item in experience %}
      {% include "timeline-item.njk" %}
    {% endfor %}
  </div>
</section>

<div class="divider"></div>

<!-- PROJECTS -->
<section id="projects">
  <p class="section-label">// 05 · projects</p>
  <h2 class="section-title">Things I've built</h2>

  {% set devProjects  = projects | selectattr("category", "equalto", "development")     | list %}
  {% set infraProjects = projects | selectattr("category", "equalto", "infrastructure") | list %}

  {% for group in [
    { "label": "Development", "items": devProjects },
    { "label": "Infrastructure & DevOps", "items": infraProjects }
  ] %}
    <div class="project-group">
      <div class="project-group-label">{{ group.label }}</div>
      <div class="projects-grid">
        {% for project in group.items %}
          <div class="project-card">
            <div class="project-card-top">
              <div class="project-icon">{{ project.icon }}</div>
              {% if project.collab %}
                <span class="project-collab">collaborative</span>
              {% endif %}
            </div>
            <h3>{{ project.title }}</h3>
            <p>{{ project.description }}</p>
            <div class="project-footer">
              <div class="project-chips">
                {% for chip in project.chips %}
                  <span class="chip">{{ chip }}</span>
                {% endfor %}
              </div>
              {% if project.link %}
                <a class="project-link" href="{{ project.link }}" target="_blank" rel="noopener" aria-label="View {{ project.title }} on GitHub">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2A10 10 0 0 0 2 12C2 16.42 4.87 20.17 8.84 21.5C9.34 21.58 9.5 21.27 9.5 21C9.5 20.77 9.5 20.14 9.5 19.31C6.73 19.91 6.14 17.97 6.14 17.97C5.68 16.81 5.03 16.5 5.03 16.5C4.12 15.88 5.1 15.9 5.1 15.9C6.1 15.97 6.63 16.93 6.63 16.93C7.5 18.45 8.97 18 9.54 17.76C9.63 17.11 9.89 16.67 10.17 16.42C7.95 16.17 5.62 15.31 5.62 11.5C5.62 10.39 6 9.5 6.65 8.79C6.55 8.54 6.2 7.5 6.75 6.15C6.75 6.15 7.59 5.88 9.5 7.17C10.29 6.95 11.15 6.84 12 6.84C12.85 6.84 13.71 6.95 14.5 7.17C16.41 5.88 17.25 6.15 17.25 6.15C17.8 7.5 17.45 8.54 17.35 8.79C18 9.5 18.38 10.39 18.38 11.5C18.38 15.32 16.04 16.16 13.81 16.41C14.17 16.72 14.5 17.33 14.5 18.26C14.5 19.6 14.5 20.68 14.5 21C14.5 21.27 14.66 21.59 15.17 21.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2Z"/></svg>
                  GitHub
                </a>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  {% endfor %}

  <div class="projects-cv-note">
    For more details on each project, see the <a href="/cv/">CV</a>.
  </div>

</section>

<div class="divider"></div>

